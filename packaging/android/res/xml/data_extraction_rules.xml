<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of Beacon's leaves the phone, by cloud backup or by device-to-device transfer.
     allowBackup=false in the manifest already says so; on Android 12 and later this is the
     form the system reads first, and some vendors' migration tools read only this one. The
     profile key is a file in the app's private storage (Android has no keychain Beacon can
     use), so a transfer that carried the data would carry the key that opens it. The device_
     domains are the device-protected storage, which the plain ones do not cover. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
