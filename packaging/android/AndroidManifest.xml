<?xml version="1.0" encoding="utf-8"?>
<!-- NativeActivity loads libbeacon_android.so and calls its android_main. The Java is
     rustls-platform-verifier's certificate check and Beacon's own helper (the date and time
     dialogs, the Downloads folder), hence hasCode; the security config is the verifier's
     (it lets Android fetch CRLs over plain HTTP).
     scripts/android-apk.sh fills in the version and builds the APK around this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.gosub.beacon">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- NoActionBar: the default theme reserves an (empty) action bar, and the content rect
         the app keeps clear of the system bars would include it.
         extractNativeLibs: the library ships compressed, which keeps the APK small.
         allowBackup=false, and dataExtractionRules excluding everything from cloud backup
         and device transfer: the profile (cookies, history, site storage) stays on this
         phone, as Firefox does it. Android has no keychain Beacon can use, so the profile
         key is a file in the app's private storage; a backup or transfer would be the one
         copy of the profile that travels with its key. Moving phones means a passphrase,
         once the app has a screen for one. -->
    <application
        android:label="Beacon"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:hasCode="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:extractNativeLibs="true">

        <!-- configChanges: rotating or folding the phone resizes the surface instead of
             restarting the activity, which would tear the whole engine down with it. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|density|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="beacon_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
