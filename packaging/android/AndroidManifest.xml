<?xml version="1.0" encoding="utf-8"?>
<!-- NativeActivity loads libbeacon_android.so and calls its android_main. The only Java
     is rustls-platform-verifier's certificate check, hence hasCode, and the security
     config is its own (it lets Android fetch CRLs over plain HTTP).
     scripts/android-apk.sh fills in the version and builds the APK around this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.gosub.beacon">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- NoActionBar: the default theme reserves an (empty) action bar, and the content rect
         the app keeps clear of the system bars would include it.
         extractNativeLibs: the library ships compressed, which keeps the APK small. -->
    <application
        android:label="Beacon"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:hasCode="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:extractNativeLibs="true">

        <!-- configChanges: rotating or folding the phone resizes the surface instead of
             restarting the activity, which would tear the whole engine down with it. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|density|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="beacon_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
