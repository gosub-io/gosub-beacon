<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <template class="BrowserWindow" parent="GtkApplicationWindow">
        <property name="title">Gosub Beacon</property>

        <!-- Row 1: slim headerbar: menus left (packed in code), title, window controls -->
        <child type="titlebar">
            <object class="GtkHeaderBar" id="headerbar">
                <property name="show-title-buttons">True</property>
            </object>
        </child>

        <child>
            <object class="GtkBox">
                <property name="orientation">vertical</property>

                <!-- Row 2: full-width tab strip -->
                <child>
                    <object class="GtkBox" id="tab_row">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">2</property>
                        <style>
                            <class name="tab-row"/>
                        </style>
                        <child>
                            <!-- automatic, NOT external: `external` does not merely hide the
                                 scrollbar, it tells GTK the adjustment is driven from outside, and
                                 the scrolled window then ignores scroll events on that axis - so
                                 the strip could not be scrolled by hand at all. Overlay scrolling
                                 keeps the indicator off the layout, so the row does not grow. -->
                            <object class="GtkScrolledWindow" id="tab_scroller">
                                <property name="hscrollbar-policy">automatic</property>
                                <property name="vscrollbar-policy">never</property>
                                <property name="overlay-scrolling">True</property>
                                <style>
                                    <class name="tab-scroller"/>
                                </style>
                                <property name="hexpand">True</property>
                                <child>
                                    <!-- Chips only. The strip holds nothing else, which is what
                                         lets insert_child_after target chips by position and
                                         CloseAll clear the strip wholesale. -->
                                    <object class="GtkBox" id="tab_strip">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">2</property>
                                    </object>
                                </child>
                            </object>
                        </child>

                        <!-- The new-tab button sits OUTSIDE the scroller, pinned to the right
                             of the row. Inside it, it trailed the last chip and scrolled off
                             with them once the strip overflowed, leaving no way to open a tab
                             with the pointer. -->
                        <child>
                            <object class="GtkButton">
                                <property name="has-frame">false</property>
                                <property name="tooltip-text">New tab</property>
                                <property name="action-name">app.open-new-tab</property>
                                <property name="valign">center</property>
                                <style>
                                    <class name="new-tab"/>
                                </style>
                                <child>
                                    <object class="GtkImage">
                                        <property name="icon-name">list-add-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                    </object>
                </child>

                <!-- Row 3: navigation toolbar -->
                <child>
                    <object class="GtkBox" id="nav_toolbar">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">5</property>
                        <property name="margin-start">8</property>
                        <property name="margin-end">8</property>
                        <property name="margin-top">4</property>
                        <property name="margin-bottom">4</property>
                        <style>
                            <class name="nav-toolbar"/>
                        </style>
                        <child>
                            <object class="GtkButton" id="btn_prev">
                                <property name="has-frame">false</property>
                                <signal name="clicked" handler="handle_prev_clicked" swapped="true"/>
                                <child>
                                    <object class="GtkImage">
                                        <property name="icon-name">go-previous-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child>
                            <object class="GtkButton" id="btn_next">
                                <property name="has-frame">false</property>
                                <signal name="clicked" handler="handle_next_clicked" swapped="true"/>
                                <child>
                                    <object class="GtkImage">
                                        <property name="icon-name">go-next-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child>
                            <object class="GtkButton" id="btn_refresh">
                                <property name="has-frame">false</property>
                                <signal name="clicked" handler="handle_refresh_clicked" swapped="true"/>
                                <child>
                                    <object class="GtkImage">
                                        <property name="icon-name">view-refresh-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child>
                            <object class="GtkButton" id="btn_home">
                                <property name="has-frame">false</property>
                                <property name="tooltip-text" translatable="yes">Home</property>
                                <signal name="clicked" handler="handle_home_clicked" swapped="true"/>
                                <child>
                                    <object class="GtkImage">
                                        <property name="icon-name">go-home-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child>
                            <object class="GtkEntry" id="searchbar">
                                <signal name="activate" handler="handle_searchbar_clicked" swapped="true"/>
                                <property name="placeholder-text" translatable="yes">Search or enter address</property>
                                <property name="primary-icon-name">channel-secure-symbolic</property>
                                <property name="hexpand">True</property>
                                <style>
                                    <class name="address-bar"/>
                                </style>
                            </object>
                        </child>
                        <child>
                            <object class="GtkButton" id="btn_bookmark">
                                <property name="has-frame">false</property>
                                <property name="tooltip-text">Bookmark this page</property>
                                <property name="valign">center</property>
                                <child>
                                    <object class="GtkImage" id="bookmark_icon">
                                        <property name="icon-name">non-starred-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child>
                            <object class="GtkButton" id="btn_view_source">
                                <property name="has-frame">false</property>
                                <property name="tooltip-text">View source</property>
                                <signal name="clicked" handler="handle_view_source_clicked" swapped="true"/>
                                <child>
                                    <object class="GtkImage">
                                        <property name="icon-name">text-x-generic-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child>
                            <object class="GtkMenuButton" id="btn_downloads">
                                <property name="has-frame">false</property>
                                <property name="tooltip-text">Downloads</property>
                                <property name="icon-name">folder-download-symbolic</property>
                                <property name="valign">center</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkToggleButton" id="btn_darkmode">
                                <property name="has-frame">false</property>
                                <property name="tooltip-text">Dark mode</property>
                                <signal name="clicked" handler="handle_toggle_darkmode" swapped="true"/>
                                <child>
                                    <object class="GtkImage">
                                        <property name="icon-name">weather-clear-night-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                    </object>
                </child>

                <!-- Row 5: slim bookmarks strip -->
                <child>
                    <object class="GtkBox" id="bookmarks_bar">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">2</property>
                        <style>
                            <class name="bookmarks-bar"/>
                        </style>
                    </object>
                </child>

                <!-- Row 6: viewport, over a draggable developer pane -->
                <child>
                    <object class="GtkPaned" id="content_paned">
                        <property name="orientation">vertical</property>
                        <property name="vexpand">True</property>
                        <property name="hexpand">True</property>
                        <!-- The page takes the slack when the window is resized; the pane
                             keeps whatever height it was given. -->
                        <property name="resize-start-child">True</property>
                        <property name="resize-end-child">False</property>
                        <!-- The page area must be shrinkable, or the drag stops almost
                             immediately: the render area asks for a minimum height of its
                             own and GtkPaned honours it. The floor that stops it reaching
                             zero is enforced in code instead, where it can be a sensible
                             number rather than whatever the renderer happens to want. -->
                        <property name="shrink-start-child">True</property>
                        <property name="shrink-end-child">False</property>
                        <!-- A hairline is hard to hit with a pointer. -->
                        <property name="wide-handle">True</property>
                    <child>
                    <object class="GtkOverlay">
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <child>
                            <object class="GtkStack" id="content_stack">
                                <property name="vexpand">True</property>
                                <property name="hexpand">True</property>
                            </object>
                        </child>
                        <child type="overlay">
                            <!-- hover-URL bubble, Firefox style -->
                            <object class="GtkLabel" id="statusbar">
                                <property name="visible">False</property>
                                <property name="can-focus">False</property>
                                <property name="halign">start</property>
                                <property name="valign">end</property>
                                <property name="single-line-mode">True</property>
                                <property name="ellipsize">end</property>
                                <property name="max-width-chars">80</property>
                                <style>
                                    <class name="status-bubble"/>
                                </style>
                            </object>
                        </child>
                    </object>
                    </child>

                <!-- developer pane: the engine's log, timings and requests -->
                    <child>
                    <object class="GtkBox" id="devtools_pane">
                        <property name="visible">False</property>
                        <property name="orientation">vertical</property>
                        <property name="vexpand">False</property>
                        <!-- The floor a drag can reach, not the height it opens at: that is
                             set from the code, and remembered across toggles. -->
                        <property name="height-request">90</property>
                        <style><class name="devtools-pane"/></style>

                        <child>
                            <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">4</property>
                                <property name="margin-start">6</property>
                                <property name="margin-end">6</property>
                                <property name="margin-top">2</property>
                                <property name="margin-bottom">2</property>
                                <style><class name="devtools-header"/></style>
                                <child>
                                    <object class="GtkStackSwitcher" id="devtools_switcher">
                                        <property name="stack">devtools_stack</property>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkButton" id="devtools_action">
                                        <property name="label">Clear</property>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkLabel" id="devtools_summary">
                                        <property name="hexpand">True</property>
                                        <property name="xalign">0</property>
                                        <style><class name="dim-label"/></style>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkSearchEntry" id="devtools_filter">
                                        <property name="placeholder-text">Filter</property>
                                        <property name="width-chars">18</property>
                                    </object>
                                </child>
                            </object>
                        </child>

                        <child>
                            <object class="GtkStack" id="devtools_stack">
                                <property name="vexpand">True</property>
                                <child>
                                    <object class="GtkStackPage">
                                        <property name="name">console</property>
                                        <property name="title">Console</property>
                                        <property name="child">
                                            <object class="GtkScrolledWindow" id="log_scroller">
                                                <property name="hscrollbar-policy">automatic</property>
                                                <property name="vscrollbar-policy">automatic</property>
                                                <child>
                                                    <object class="GtkTextView" id="log">
                                                        <property name="monospace">True</property>
                                                        <property name="editable">False</property>
                                                        <property name="cursor-visible">False</property>
                                                        <property name="hexpand">True</property>
                                                    </object>
                                                </child>
                                            </object>
                                        </property>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkStackPage">
                                        <property name="name">timings</property>
                                        <property name="title">Timings</property>
                                        <property name="child">
                                            <object class="GtkBox">
                                                <property name="orientation">vertical</property>
                                                <!-- Outside the scroller, so the column
                                                     titles stay put while the rows move. -->
                                                <child>
                                                    <object class="GtkLabel" id="timings_header">
                                                        <property name="xalign">0</property>
                                                        <property name="single-line-mode">True</property>
                                                        <style><class name="table-header"/></style>
                                                    </object>
                                                </child>
                                                <child>
                                                    <object class="GtkScrolledWindow" id="timings_scroller">
                                                        <property name="hscrollbar-policy">automatic</property>
                                                        <property name="vscrollbar-policy">automatic</property>
                                                        <property name="vexpand">True</property>
                                                        <child>
                                                            <object class="GtkTextView" id="timings_view">
                                                                <property name="monospace">True</property>
                                                                <property name="editable">False</property>
                                                                <property name="cursor-visible">False</property>
                                                                <property name="hexpand">True</property>
                                                                <style><class name="table-body"/></style>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                            </object>
                                        </property>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkStackPage">
                                        <property name="name">network</property>
                                        <property name="title">Network</property>
                                        <property name="child">
                                            <object class="GtkPaned">
                                                <property name="orientation">horizontal</property>
                                                <property name="position">560</property>
                                                <property name="shrink-start-child">False</property>
                                                <property name="shrink-end-child">False</property>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="orientation">vertical</property>
                                                        <!-- The column titles sit outside the
                                                             scroller, so they stay put while
                                                             the list scrolls under them. -->
                                                        <child>
                                                            <object class="GtkBox" id="network_header">
                                                                <property name="orientation">horizontal</property>
                                                                <style><class name="table-header"/></style>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkScrolledWindow" id="network_scroller">
                                                                <!-- Never: the fixed header
                                                                     above cannot follow a
                                                                     sideways scroll, and the
                                                                     rows already ellipsize. -->
                                                                <property name="hscrollbar-policy">never</property>
                                                                <property name="vscrollbar-policy">automatic</property>
                                                                <property name="vexpand">True</property>
                                                                <child>
                                                                    <object class="GtkListBox" id="network_list">
                                                                        <property name="selection-mode">single</property>
                                                                        <style><class name="network-list"/></style>
                                                                    </object>
                                                                </child>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="orientation">vertical</property>
                                                        <property name="width-request">340</property>
                                                        <child>
                                                            <object class="GtkBox">
                                                                <property name="orientation">horizontal</property>
                                                                <property name="spacing">6</property>
                                                                <property name="margin-start">6</property>
                                                                <property name="margin-end">6</property>
                                                                <property name="margin-top">3</property>
                                                                <property name="margin-bottom">3</property>
                                                                <style><class name="devtools-header"/></style>
                                                                <child>
                                                                    <object class="GtkStackSwitcher" id="network_detail_switcher">
                                                                        <property name="stack">network_detail_stack</property>
                                                                        <property name="halign">start</property>
                                                                    </object>
                                                                </child>
                                                                <child>
                                                                    <object class="GtkToggleButton" id="detail_raw">
                                                                        <property name="label">Raw</property>
                                                                        <property name="tooltip-text">Show the request and response as they went over the wire</property>
                                                                    </object>
                                                                </child>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkStack" id="network_detail_stack">
                                                                <property name="vexpand">True</property>
                                                        <child>
                                                            <object class="GtkStackPage">
                                                                <property name="name">request</property>
                                                                <property name="title">Request</property>
                                                                <property name="child">
                                                                    <object class="GtkStack" id="request_stack">
                                                                        <child>
                                                                            <object class="GtkStackPage">
                                                                                <property name="name">formatted</property>
                                                                                <property name="child"><object class="GtkScrolledWindow">
                                                                        <property name="hscrollbar-policy">never</property>
                                                                        <property name="vscrollbar-policy">automatic</property>
                                                                        <child>
                                                                            <object class="GtkListBox" id="request_list">
                                                                                <property name="selection-mode">none</property>
                                                                                <style><class name="striped-list"/></style>
                                                                            </object>
                                                                        </child>
                                                                    </object></property>
                                                                            </object>
                                                                        </child>
                                                                        <child>
                                                                            <object class="GtkStackPage">
                                                                                <property name="name">raw</property>
                                                                                <property name="child"><object class="GtkScrolledWindow">
                                                                        <property name="hscrollbar-policy">automatic</property>
                                                                        <property name="vscrollbar-policy">automatic</property>
                                                                        <child>
                                                                            <object class="GtkTextView" id="network_request_view">
                                                                                <property name="monospace">True</property>
                                                                                <property name="editable">False</property>
                                                                                <property name="cursor-visible">False</property>
                                                                                <property name="left-margin">8</property>
                                                                                <property name="top-margin">6</property>
                                                                                <property name="wrap-mode">word-char</property>
                                                                                <style><class name="table-body"/></style>
                                                                            </object>
                                                                        </child>
                                                                    </object></property>
                                                                            </object>
                                                                        </child>
                                                                    </object>
                                                                </property>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkStackPage">
                                                                <property name="name">response</property>
                                                                <property name="title">Response</property>
                                                                <property name="child">
                                                                    <object class="GtkStack" id="response_stack">
                                                                        <child>
                                                                            <object class="GtkStackPage">
                                                                                <property name="name">formatted</property>
                                                                                <property name="child"><object class="GtkScrolledWindow">
                                                                        <property name="hscrollbar-policy">never</property>
                                                                        <property name="vscrollbar-policy">automatic</property>
                                                                        <child>
                                                                            <object class="GtkListBox" id="response_list">
                                                                                <property name="selection-mode">none</property>
                                                                                <style><class name="striped-list"/></style>
                                                                            </object>
                                                                        </child>
                                                                    </object></property>
                                                                            </object>
                                                                        </child>
                                                                        <child>
                                                                            <object class="GtkStackPage">
                                                                                <property name="name">raw</property>
                                                                                <property name="child"><object class="GtkScrolledWindow">
                                                                        <property name="hscrollbar-policy">automatic</property>
                                                                        <property name="vscrollbar-policy">automatic</property>
                                                                        <child>
                                                                            <object class="GtkTextView" id="network_response_view">
                                                                                <property name="monospace">True</property>
                                                                                <property name="editable">False</property>
                                                                                <property name="cursor-visible">False</property>
                                                                                <property name="left-margin">8</property>
                                                                                <property name="top-margin">6</property>
                                                                                <property name="wrap-mode">word-char</property>
                                                                                <style><class name="table-body"/></style>
                                                                            </object>
                                                                        </child>
                                                                    </object></property>
                                                                            </object>
                                                                        </child>
                                                                    </object>
                                                                </property>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkStackPage">
                                                                <property name="name">body</property>
                                                                <property name="title">Body</property>
                                                                <property name="child"><object class="GtkScrolledWindow">
                                                                        <property name="hscrollbar-policy">automatic</property>
                                                                        <property name="vscrollbar-policy">automatic</property>
                                                                        <child>
                                                                            <object class="GtkTextView" id="network_body_view">
                                                                                <property name="monospace">True</property>
                                                                                <property name="editable">False</property>
                                                                                <property name="cursor-visible">False</property>
                                                                                <property name="left-margin">8</property>
                                                                                <property name="top-margin">6</property>
                                                                                <property name="wrap-mode">word-char</property>
                                                                                <style><class name="table-body"/></style>
                                                                            </object>
                                                                        </child>
                                                                    </object></property>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkStackPage">
                                                                <property name="name">subresources</property>
                                                                <property name="title">Subresources</property>
                                                                <property name="child"><object class="GtkScrolledWindow">
                                                                        <property name="hscrollbar-policy">never</property>
                                                                        <property name="vscrollbar-policy">automatic</property>
                                                                        <child>
                                                                            <object class="GtkListBox" id="sub_list">
                                                                                <property name="selection-mode">none</property>
                                                                                <style><class name="striped-list"/></style>
                                                                            </object>
                                                                        </child>
                                                                    </object></property>
                                                            </object>
                                                        </child>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                            </object>
                                        </property>
                                    </object>
                                </child>
                            </object>
                        </child>
                    </object>
                    </child>
                    </object>
                </child>

            </object>
        </child>
    </template>
</interface>
