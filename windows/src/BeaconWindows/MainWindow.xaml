<Window x:Class="Gosub.Beacon.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gosub.Beacon.Windows"
        Title="Gosub Beacon" Height="820" Width="1240"
        UseLayoutRounding="True">
    <DockPanel>

        <!-- Built in code: the Bookmarks and History menus are populated from the engine
             each time they open, so the whole bar is assembled in one place. -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Top" Background="#EEE" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <local:TabStrip x:Name="Tabs" />
        </Border>

        <Border DockPanel.Dock="Top" Background="#F6F6F6" BorderBrush="#DDD"
                BorderThickness="0,0,0,1" Padding="4">
            <DockPanel>
                <Button x:Name="BackButton" Content="&#x2190;" Style="{StaticResource ToolButton}"
                        ToolTip="Back (Alt+Left)" />
                <Button x:Name="ForwardButton" Content="&#x2192;" Style="{StaticResource ToolButton}"
                        ToolTip="Forward (Alt+Right) - right-click for branches" />
                <Button x:Name="ReloadButton" Content="&#x21BB;" Style="{StaticResource ToolButton}"
                        ToolTip="Reload (F5)" />
                <Button x:Name="BookmarkButton" Content="&#x2606;" Style="{StaticResource ToolButton}"
                        ToolTip="Bookmark this page (Ctrl+D)" DockPanel.Dock="Right" />
                <TextBox x:Name="AddressBar" Margin="6,0,0,0" Padding="4,3"
                         VerticalContentAlignment="Center" FontSize="13" />
            </DockPanel>
        </Border>

        <Border x:Name="BookmarksBarHost" DockPanel.Dock="Top" Background="#FAFAFA"
                BorderBrush="#E4E4E4" BorderThickness="0,0,0,1">
            <local:BookmarksBar x:Name="Bookmarks" />
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F6F6F6" BorderBrush="#DDD"
                BorderThickness="0,1,0,0" Padding="6,2">
            <DockPanel>
                <TextBlock x:Name="ZoomLabel" DockPanel.Dock="Right" FontSize="11"
                           Foreground="#777" Margin="8,0,0,0" />
                <TextBlock x:Name="StatusLine" FontSize="11" Foreground="#555"
                           TextTrimming="CharacterEllipsis" Text="Ready" />
            </DockPanel>
        </Border>

        <!-- ClipToBounds so a frame larger than the viewport, during a resize, cannot paint
             over the chrome. -->
        <Border x:Name="PageHost" Background="White" ClipToBounds="True" />

    </DockPanel>
</Window>
