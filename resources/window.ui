<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <template class="BrowserWindow" parent="GtkApplicationWindow">
        <property name="title">Gosub Beacon</property>

        <!-- Row 1: slim headerbar: menus left (packed in code), title, window controls -->
        <child type="titlebar">
            <object class="GtkHeaderBar" id="headerbar">
                <property name="show-title-buttons">True</property>
            </object>
        </child>

        <child>
            <object class="GtkBox">
                <property name="orientation">vertical</property>

                <!-- Row 2: full-width tab strip -->
                <child>
                    <object class="GtkBox" id="tab_row">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">2</property>
                        <style>
                            <class name="tab-row"/>
                        </style>
                        <child>
                            <object class="GtkScrolledWindow">
                                <property name="hscrollbar-policy">external</property>
                                <property name="vscrollbar-policy">never</property>
                                <property name="hexpand">True</property>
                                <child>
                                    <object class="GtkBox" id="tab_strip">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">2</property>
                                        <!-- The new-tab button lives INSIDE the strip so it
                                             trails the last tab. Chips are inserted before it
                                             (insert_child_after only ever targets chips), and
                                             CloseAll removes chips only, so it stays last. -->
                                        <child>
                                            <object class="GtkButton">
                                                <property name="has-frame">false</property>
                                                <property name="tooltip-text">New tab</property>
                                                <property name="action-name">app.open-new-tab</property>
                                                <property name="valign">center</property>
                                                <style>
                                                    <class name="new-tab"/>
                                                </style>
                                                <child>
                                                    <object class="GtkImage">
                                                        <property name="icon-name">list-add-symbolic</property>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>
                                    </object>
                                </child>
                            </object>
                        </child>
                    </object>
                </child>

                <!-- Row 3: navigation toolbar -->
                <child>
                    <object class="GtkBox" id="nav_toolbar">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">5</property>
                        <property name="margin-start">8</property>
                        <property name="margin-end">8</property>
                        <property name="margin-top">4</property>
                        <property name="margin-bottom">4</property>
                        <style>
                            <class name="nav-toolbar"/>
                        </style>
                        <child>
                            <object class="GtkButton" id="btn_prev">
                                <property name="has-frame">false</property>
                                <signal name="clicked" handler="handle_prev_clicked" swapped="true"/>
                                <child>
                                    <object class="GtkImage">
                                        <property name="icon-name">go-previous-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child>
                            <object class="GtkButton" id="btn_next">
                                <property name="has-frame">false</property>
                                <signal name="clicked" handler="handle_next_clicked" swapped="true"/>
                                <child>
                                    <object class="GtkImage">
                                        <property name="icon-name">go-next-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child>
                            <object class="GtkButton" id="btn_refresh">
                                <property name="has-frame">false</property>
                                <signal name="clicked" handler="handle_refresh_clicked" swapped="true"/>
                                <child>
                                    <object class="GtkImage">
                                        <property name="icon-name">view-refresh-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child>
                            <object class="GtkEntry" id="searchbar">
                                <signal name="activate" handler="handle_searchbar_clicked" swapped="true"/>
                                <property name="placeholder-text" translatable="yes">Search or enter address</property>
                                <property name="primary-icon-name">channel-secure-symbolic</property>
                                <property name="hexpand">True</property>
                                <style>
                                    <class name="address-bar"/>
                                </style>
                            </object>
                        </child>
                        <child>
                            <object class="GtkButton" id="btn_bookmark">
                                <property name="has-frame">false</property>
                                <property name="tooltip-text">Bookmark this page</property>
                                <property name="valign">center</property>
                                <child>
                                    <object class="GtkImage" id="bookmark_icon">
                                        <property name="icon-name">non-starred-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child>
                            <object class="GtkButton" id="btn_view_source">
                                <property name="has-frame">false</property>
                                <property name="tooltip-text">View source</property>
                                <signal name="clicked" handler="handle_view_source_clicked" swapped="true"/>
                                <child>
                                    <object class="GtkImage">
                                        <property name="icon-name">text-x-generic-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child>
                            <object class="GtkMenuButton" id="btn_downloads">
                                <property name="has-frame">false</property>
                                <property name="tooltip-text">Downloads</property>
                                <property name="icon-name">folder-download-symbolic</property>
                                <property name="valign">center</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkToggleButton" id="btn_darkmode">
                                <property name="has-frame">false</property>
                                <property name="tooltip-text">Dark mode</property>
                                <signal name="clicked" handler="handle_toggle_darkmode" swapped="true"/>
                                <child>
                                    <object class="GtkImage">
                                        <property name="icon-name">weather-clear-night-symbolic</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                    </object>
                </child>

                <!-- Row 5: slim bookmarks strip -->
                <child>
                    <object class="GtkBox" id="bookmarks_bar">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">2</property>
                        <style>
                            <class name="bookmarks-bar"/>
                        </style>
                    </object>
                </child>

                <!-- Row 6: viewport -->
                <child>
                    <object class="GtkOverlay">
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <child>
                            <object class="GtkStack" id="content_stack">
                                <property name="vexpand">True</property>
                                <property name="hexpand">True</property>
                            </object>
                        </child>
                        <child type="overlay">
                            <!-- hover-URL bubble, Firefox style -->
                            <object class="GtkLabel" id="statusbar">
                                <property name="visible">False</property>
                                <property name="can-focus">False</property>
                                <property name="halign">start</property>
                                <property name="valign">end</property>
                                <property name="single-line-mode">True</property>
                                <property name="ellipsize">end</property>
                                <property name="max-width-chars">80</property>
                                <style>
                                    <class name="status-bubble"/>
                                </style>
                            </object>
                        </child>
                    </object>
                </child>

                <!-- log screen -->
                <child>
                    <object class="GtkScrolledWindow" id="log_scroller">
                        <property name="visible">False</property>
                        <property name="vexpand">False</property>
                        <property name="hscrollbar-policy">never</property>
                        <property name="vscrollbar-policy">automatic</property>
                        <property name="height-request">100</property>
                        <child>
                            <object class="GtkTextView" id="log">
                                <property name="monospace">True</property>
                                <property name="editable">False</property>
                                <property name="cursor-visible">False</property>
                                <property name="hexpand">True</property>
                            </object>
                        </child>
                    </object>
                </child>

            </object>
        </child>
    </template>
</interface>
